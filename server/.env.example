# 火山方舟（豆包）默认配置 — https://console.volcengine.com/ark
# 1. 开通方舟 → 创建 API Key
# 2. 模型推理 → 创建「推理接入点」，复制接入点 ID（ep-xxxx）填到 ARK_MODEL
# 也可不填，启动后在页面「模型设置」里配置（写入本机 server/data/，不进 Git）

ARK_API_KEY=your_ark_api_key_here
ARK_MODEL=ep-xxxxxxxxxxxxxxxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选：读图审核专用；默认与 ARK_MODEL 相同
# ARK_VISION_MODEL=ep-xxxxxxxxxxxxxxxx

# 可选：联网搜索优先使用真实搜索 API；未配置时回退到公开网页搜索
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
# SERPER_API_KEY=xxxxxxxxxxxxxxxx

# 可选：提醒同步到日历。未配置时仍会正常写入本地提醒。
# macOS 本地系统日历（无需 token，需授权控制 Calendar）
# macOS 上不设置也会默认启用本地日历
# CALENDAR_SYNC_PROVIDER=local
# LOCAL_CALENDAR_NAME=青柠提醒
# 本地日历提醒提前量（分钟），默认 10
# LOCAL_CALENDAR_ALERT_MINUTES=10
# Google 日历
# CALENDAR_SYNC_PROVIDER=google
# GOOGLE_CALENDAR_ACCESS_TOKEN=ya29.xxxxxxxxxxxxxxxx
# GOOGLE_CALENDAR_ID=primary
# 飞书日历
# FEISHU_CALENDAR_ACCESS_TOKEN=t-xxxxxxxxxxxxxxxx
# FEISHU_CALENDAR_ID=xxxxxxxxxxxxxxxx

# 可选：登录与跨域。密码在页面首次打开时设置，无需在此配置。
# 会话有效期（天），默认 30
# AUTH_SESSION_TTL_DAYS=30
# 上 HTTPS 后设为 true，让 Cookie 只在加密连接发送
# AUTH_COOKIE_SECURE=false
# 允许的跨域来源（逗号分隔）；默认 http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
