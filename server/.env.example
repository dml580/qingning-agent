# 火山方舟（豆包）默认配置 — https://console.volcengine.com/ark
# 1. 开通方舟 → 创建 API Key
# 2. 模型推理 → 创建「推理接入点」，复制接入点 ID（ep-xxxx）填到 ARK_MODEL
# 也可不填，启动后在页面「模型设置」里配置（写入本机 server/data/，不进 Git）

ARK_API_KEY=your_ark_api_key_here
ARK_MODEL=ep-xxxxxxxxxxxxxxxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选：读图审核专用；默认与 ARK_MODEL 相同
# ARK_VISION_MODEL=ep-xxxxxxxxxxxxxxxx
